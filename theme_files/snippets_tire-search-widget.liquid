    <!-- Tire Size Panel -->
    <div id="tsw-tiresize" class="tsw-panel active">
      <p class="tsw-help">Not sure what your tire size is? <a href="/pages/how-to-find-tire-size">Let us help</a></p>

      <div class="tsw-field">
        <span class="tsw-label" id="tsw-label-width">Width</span>
        <select id="tsw-width" class="tsw-select" onchange="tswUpdateRatio()">
          <option value="">Select</option>
        </select>
      </div>

      <div class="tsw-divider" id="tsw-divider-ratio">/</div>

      <div class="tsw-field">
        <span class="tsw-label" id="tsw-label-ratio">Ratio</span>
        <select id="tsw-ratio" class="tsw-select" onchange="tswUpdateRim()" disabled>
          <option value="">Select</option>
        </select>
      </div>

      <div class="tsw-divider">R</div>

      <div class="tsw-field">
        <span class="tsw-label">Rim Size</span>
        <select id="tsw-rim" class="tsw-select" onchange="tswCheckRefine()" disabled>
          <option value="">Select</option>
        </select>
      </div>

      <div class="tsw-field">
        <span class="tsw-label">Season</span>
        <select id="tsw-season" class="tsw-select">
          <option value="">All</option>
          <option value="Type_All-Season">All Season</option>
          <option value="Type_All-Weather">All Weather</option>
          <option value="Type_Winter">Winter</option>
          <option value="Type_Summer">Summer</option>
          <option value="Type_All-Terrain">All Terrain</option>
          <option value="Type_Mud-Snow">Mud Terrain</option>
