{% assign tsw_tire_sizes = '' %}
{% assign tsw_flotation_sizes = '' %}
{% for tag in collections['tires'].all_tags %}
  {% if tag contains 'Size_' %}
    {% assign sz = tag | remove_first: 'Size_' %}
    {% if sz contains '/' %}
      {% assign tsw_tire_sizes = tsw_tire_sizes | append: sz | append: '|' %}
    {% elsif sz contains 'X' %}
      {% if sz contains 'R' %}
        {% assign tsw_flotation_sizes = tsw_flotation_sizes | append: sz | append: '|' %}
      {% endif %}
    {% endif %}
  {% endif %}
{% endfor %}

{% assign tsw_wheel_sizes = '' %}
{% for tag in collections['wheels'].all_tags %}
  {% if tag contains 'Size_' %}
    {% assign sz = tag | remove_first: 'Size_' %}
    {% if sz contains 'X' %}
      {% assign tsw_wheel_sizes = tsw_wheel_sizes | append: sz | append: '|' %}
    {% endif %}
  {% endif %}
{% endfor %}

{% assign tsw_speed_ratings = '' %}
{% assign tsw_load_ranges = '' %}
{% for tag in collections['tires'].all_tags %}
  {% if tag contains 'SpeedRating_' %}
    {% assign sr = tag | remove_first: 'SpeedRating_' %}
    {% assign tsw_speed_ratings = tsw_speed_ratings | append: sr | append: '|' %}
  {% elsif tag contains 'LoadRange_' %}
    {% assign lr = tag | remove_first: 'LoadRange_' %}
    {% assign tsw_load_ranges = tsw_load_ranges | append: lr | append: '|' %}
  {% endif %}
{% endfor %}

<style>
  .tsw-outer {
    background: #1a1a1a;
    font-family: 'Gibson', 'Helvetica Neue', Arial, sans-serif;
  }

  .tsw-section {
    max-width: 1200px;
    margin: 0 auto;
  }

  .tsw-tabs {
    display: flex;
    border-bottom: none;
  }

  .tsw-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 22px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: #ccc;
    background: #2a2a2a;
    border: none;
    border-right: 1px solid #444;
    transition: background 0.2s, color 0.2s;
    white-space: nowrap;
  }

  .tsw-tab:hover { background: #333; color: #fff; }

  .tsw-tab.active {
    background: #111;
    color: #fff;
    border-bottom: 3px solid #d70000;
  }

  .tsw-tab svg { width: 20px; height: 20px; flex-shrink: 0; }

  .tsw-panel {
    display: none;
    background: #111;
    padding: 20px 24px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .tsw-panel.active { display: flex; }

  .tsw-help {
    width: 100%;
    font-size: 13px;
    color: #aaa;
    margin-bottom: 4px;
    text-align: center;
  }

  .tsw-help a { color: #4a9eff; text-decoration: none; }

  .tsw-field { display: flex; flex-direction: column; gap: 4px; }

  .tsw-label {
    font-size: 12px;
    font-weight: 600;
    color: #aaa;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .tsw-select {
    padding: 10px 14px;
    border: 1px solid #444;
    border-radius: 4px;
    background: #fff;
    color: #333;
    font-size: 14px;
    min-width: 110px;
    cursor: pointer;
  }

  .tsw-select:focus { outline: none; border-color: #d70000; }

  .tsw-divider {
    color: #555;
    font-size: 20px;
    font-weight: 300;
    align-self: flex-end;
    padding-bottom: 10px;
    min-width: 14px;
    text-align: center;
  }

  .tsw-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 28px;
    background: #22a020;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    align-self: flex-end;
    margin-bottom: 1px;
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 50%, calc(100% - 12px) 100%, 0 100%);
    padding-right: 36px;
    transition: background 0.2s;
  }

  .tsw-btn:hover { background: #1a8018; }

  .tsw-checkbox-row {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 4px;
  }

  .tsw-checkbox-row input[type="checkbox"] {
    width: 16px;
    height: 16px;
    cursor: pointer;
    accent-color: #d70000;
  }

  .tsw-checkbox-row label {
    font-size: 13px;
    color: #ccc;
    cursor: pointer;
    user-select: none;
  }

  @media (max-width: 768px) {
    .tsw-tab { padding: 12px 14px; font-size: 13px; }
    .tsw-panel { padding: 16px; gap: 10px; }
    .tsw-select { min-width: 90px; }
    .tsw-btn {
      width: 100%;
      justify-content: center;
      clip-path: none;
      padding-right: 28px;
      margin-top: 4px;
    }
  }

  @media (max-width: 480px) {
    .tsw-tabs { overflow-x: auto; }
    .tsw-tab span { display: none; }
    .tsw-select { min-width: 80px; font-size: 13px; }
  }

  .tsw-refine-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: none;
    border: 1px solid #555;
    border-radius: 4px;
    color: #aaa;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    padding: 6px 16px;
    margin-top: 4px;
    transition: border-color 0.2s, color 0.2s;
  }
  .tsw-refine-toggle:hover { border-color: #888; color: #fff; }
  .tsw-refine-toggle.visible { display: flex; }

  .tsw-refine-panel {
    display: none;
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 4px;
  }
  .tsw-refine-panel.open { display: flex; }

  .tsw-supplier-bar {
    background: #0d0d0d;
    padding: 7px 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid #333;
  }
  .tsw-supplier-label {
    font-size: 11px;
    font-weight: 600;
    color: #777;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }
  .tsw-supplier-select {
    padding: 4px 10px;
    border: 1px solid #555;
    border-radius: 4px;
    background: #222;
    color: #fff;
    font-size: 13px;
    cursor: pointer;
    font-family: 'Gibson', 'Helvetica Neue', Arial, sans-serif;
  }
  .tsw-supplier-select:focus { outline: none; border-color: #d70000; }
</style>

