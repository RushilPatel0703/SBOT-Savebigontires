<script>
  // Mobile filter toggle functionality
  function toggleFilters() {
    const sidebar = document.getElementById('collectionFilters');
    const closeBtn = sidebar.querySelector('.close-filters');
    
    if (sidebar.classList.contains('show-filters')) {
      sidebar.classList.remove('show-filters');
      closeBtn.style.display = 'none';
      document.body.style.overflow = '';
    } else {
      sidebar.classList.add('show-filters');
      closeBtn.style.display = 'block';
      document.body.style.overflow = 'hidden';
    }
  }

  // Close filters when clicking outside on mobile
  document.addEventListener('click', function(event) {
    const sidebar = document.getElementById('collectionFilters');
    const toggleBtn = document.querySelector('.savebigontires-filter-toggle');
    
    if (sidebar && sidebar.classList.contains('show-filters')) {
      if (!sidebar.contains(event.target) && !toggleBtn.contains(event.target)) {
        toggleFilters();
      }
    }
  });

  // Handle window resize
  window.addEventListener('resize', function() {
    const sidebar = document.getElementById('collectionFilters');
    if (sidebar && window.innerWidth > 768) {
      sidebar.classList.remove('show-filters');
      sidebar.querySelector('.close-filters').style.display = 'none';
      document.body.style.overflow = '';
    }
  });

  // Add scrollable class to filter lists that need scrolling
  function initScrollableFilters() {
    const filterLists = document.querySelectorAll('.savebigontires-filter-list, .filter-list');
    filterLists.forEach(function(list) {
      if (list.scrollHeight > list.clientHeight) {
        list.classList.add('scrollable');
      }
    });
  }

  // Make sidebar scrollable independently
  function makeFiltersSidebarScrollable() {
    const sidebar = document.querySelector('.savebigontires-collection-sidebar');
    if (sidebar) {
      // Disable scrolling on the main sidebar container
      sidebar.style.overflow = 'visible';
      sidebar.style.maxHeight = 'none'; // Remove height constraint
      
      // Remove any wheel event listeners that might interfere
      // Individual filter lists will handle their own scrolling via CSS
    }
  }

  // Initialize scrollable filters when DOM is loaded
  document.addEventListener('DOMContentLoaded', function() {
    initScrollableFilters();
    makeFiltersSidebarScrollable();
  });
  
  // Re-initialize on window resize
  window.addEventListener('resize', function() {
    initScrollableFilters();
    makeFiltersSidebarScrollable();
  });
</script>

