{% comment %}
  SaveBig Collection Rows Section
  Modern product showcase with responsive grid layout
{% endcomment %}

<style>
  /*============================================================================
    SaveBig Collection Rows Styles
    Professional product showcase with modern grid layout
  ==============================================================================*/
  .savebigontires-collection-rows {
    background-color: #fff;
    padding: 60px 0;
    font-family: 'Gibson', 'Helvetica Neue', Arial, sans-serif;
  }

  .savebigontires-collection-rows .savebigontires-container {
    max-width: 1296px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .savebigontires-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 40px;
    padding-bottom: 20px;
    border-bottom: 2px solid #e9ecef;
  }

  .savebigontires-section-title {
    color: #1a1a1a;
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }

  .savebigontires-section-link {
    color: #e31e24;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    padding: 12px 24px;
    border: 2px solid #e31e24;
    border-radius: 6px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .savebigontires-section-link:hover {
    background-color: #e31e24;
    color: white;
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(227, 30, 36, 0.3);
  }

  .savebigontires-products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    margin: 0;
  }

  /* Override default grid styles for better layout */
  .savebigontires-collection-rows .grid-uniform {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    margin: 0;
    padding: 0;
  }

  .savebigontires-collection-rows .grid-item {
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .savebigontires-collection-rows .savebigontires-product-grid-item {
    width: 100%;
  }

  /* Product card enhancements for this section */
  .savebigontires-collection-rows .savebigontires-product-card {
    border-radius: 12px;
    transition: all 0.3s ease;
    background: linear-gradient(145deg, #ffffff 0%, #f8f9fa 100%);
    border: 1px solid #e9ecef;
  }

  .savebigontires-collection-rows .savebigontires-product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(26, 26, 26, 0.15);
  }

  /* Desktop optimization for more products */
  @media (min-width: 1200px) {
    /* Desktop grid sizes already set in main styles */
  }

  @media (min-width: 1024px) and (max-width: 1199px) {
    /* Desktop grid sizes already set in main styles */
  }

  @media (max-width: 1023px) {
    .savebigontires-collection-rows .grid-uniform,
    .savebigontires-products-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .savebigontires-collection-rows {
      padding: 40px 0;
    }

    .savebigontires-collection-rows .savebigontires-container {
      padding: 0 16px;
    }

    .savebigontires-section-header {
      /* Keep horizontal layout on mobile */
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 30px;
      flex-wrap: nowrap;
    }

    .savebigontires-section-title {
      font-size: 1.8rem;
      flex: 1;
      min-width: 0;
    }

    .savebigontires-section-link {
      font-size: 14px;
      padding: 10px 16px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .savebigontires-collection-rows .grid-uniform,
    .savebigontires-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 480px) {
    .savebigontires-section-title {
      font-size: 1.5rem;
    }

    .savebigontires-section-link {
      font-size: 12px;
      padding: 8px 12px;
    }

    .savebigontires-collection-rows .grid-uniform,
    .savebigontires-products-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }
  }

  /* Empty state styling */
  .savebigontires-collection-empty {
    text-align: center;
    padding: 80px 20px;
    background-color: #f8f9fa;
    border-radius: 12px;
    border: 2px dashed #dee2e6;
  }

  .savebigontires-collection-empty h3 {
    color: #6c757d;
    font-size: 1.5rem;
    margin-bottom: 16px;
  }

  .savebigontires-collection-empty p {
    color: #6c757d;
    font-size: 16px;
    margin: 0;
  }

  /* Hide product sections on mobile homepage only */
  @media (max-width: 768px) {
    #shopify-section-collection-row-1,
    #shopify-section-collection-row-2,
    #shopify-section-collection-row-3,
    #shopify-section-1647382707df9bc4a1,
    #shopify-section-1599190493344,
    #shopify-section-1599194965694 {
      display: none !important;
    }
  }
</style>

<div class="savebigontires-collection-rows" id="collection-rows--{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="collection-row-section">

{% assign featured_row = section.settings.home_featured_row %}

{%- comment -%} Handle both string and number values for grid {%- endcomment -%}
{% assign grid_value = section.settings.products_per_row | default: section.settings.grid %}
{% if grid_value == blank %}
  {% assign grid_value = 4 %}
{% endif %}
{% assign grid_number = grid_value | plus: 0 %}

{%- comment -%} Handle both string and number values for rows {%- endcomment -%}
{% assign rows_value = section.settings.number_of_rows | default: section.settings.rows %}
{% if rows_value == blank %}
  {% assign rows_value = 1 %}
{% endif %}
{% assign rows_number = rows_value | plus: 0 %}

{% case grid_number %}
  {% when 2 %}
    {%- assign grid_item_width = 'medium--one-half large--one-half' -%}
    {%- assign image_size = '540x' -%}
    {% assign width = '540' %}
    {% assign height = '600' %}
  {% when 3 %}
    {%- assign grid_item_width = 'small--one-half medium--one-third large--one-third' -%}
     {%- assign image_size = '345x' -%}
     {% assign width = '345' %}
    {% assign height = '550' %}
  {% when 4 %}
    {%- assign grid_item_width = 'small--one-half medium--one-quarter large--one-quarter' -%}
    {%- assign image_size = '250x' -%}
    {% assign width = '250' %}
    {% assign height = '225' %}
  {% when 5 %}
    {%- assign grid_item_width = 'small--one-half medium--one-fifth large--one-fifth' -%}
    {%- assign image_size = '195x' -%}
    {% assign width = '195' %}
    {% assign height = '175' %}
  {% when 6 %}
    {%- assign grid_item_width = 'small--one-half medium--one-third large--one-sixth' -%}
    {%- assign image_size = '180x' -%}
    {% assign width = '180' %}
    {% assign height = '160' %}
  {% when 8 %}
    {%- assign grid_item_width = 'small--one-half medium--one-quarter large--one-eighth' -%}
    {%- assign image_size = '150x' -%}
    {% assign width = '150' %}
    {% assign height = '140' %}
{% endcase %}

{%- assign product_limit = grid_number | times: rows_number -%}
{% assign header_title = collections[featured_row].title %}
{%- assign more_link = collections[featured_row].url -%}

<div class="savebigontires-container">
  {% if collections[featured_row].all_products_count != 0 and section.settings.home_featured_row != blank %}

    {% if section.settings.title != blank %}
      <div class="savebigontires-section-header">
        <h2 class="savebigontires-section-title">{{ section.settings.title | escape }}</h2>
        {% if more_link %}
          <a href="{{ more_link }}" class="savebigontires-section-link">
            View All {{ header_title }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="grid-uniform savebigontires-products-grid">
      {% for product in collections[featured_row].products limit: product_limit %}
        {% assign current_collection = collections[featured_row] %}
        <div class="savebigontires-product-grid-item">
          {% include 'item-card', product: product %}
        </div>
      {% endfor %}
    </div>

  {% else %}
    <div class="savebigontires-section-header">
      <h2 class="savebigontires-section-title">{{ section.settings.title | escape }}</h2>
      <a href="{{ collections[featured_row].url }}" class="savebigontires-section-link">
        Explore Collection
      </a>
    </div>

    <div class="savebigontires-collection-empty">
      <h3>No Products Found</h3>
      <p>This collection is empty or doesn't exist. Please check your collection settings.</p>
    </div>
  {% endif %}
</div>

</div>

{% schema %}
{
  "name": "Product row",
  "class": "collection-row-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "id": "home_featured_row",
      "type": "collection",
      "label": "Collection"
    },
    {
      "type": "select",
      "id": "products_per_row",
      "label": "Products per row",
      "default": "4",
      "options": [
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        },
        {
          "value": "8",
          "label": "8"
        }
      ]
    },
    {
      "type": "select",
      "id": "number_of_rows",
      "label": "Number of rows",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "product_show_saved_amount",
      "label": "Show saved amount",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "product_show_compare_at_price",
      "label": "Show compare at price",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Product row",
      "category": "Collections"
    }
  ]
}
{% endschema %} 