# Copy to .env and fill in. Never commit .env.

# ── Warehouse backend ─────────────────────────────────────────────────────────
# local  — embedded DuckDB file at production/Data/warehouse.duckdb. No server.
#          What the dashboard's Sync button uses.
# hasura — Hasura Cloud over Neon. What the unattended cloud run should use.
# Default is 'local' when unset. Setting this to 'hasura' is THE switch that
# moves a box from laptop mode to cloud mode; the pipeline steps do not change.
SBOT_WAREHOUSE=local

# Only needed when SBOT_WAREHOUSE=hasura.
HASURA_GRAPHQL_ENDPOINT=https://your-project.hasura.app/v1/graphql
HASURA_ADMIN_SECRET=
HASURA_SOURCE=SBOTPipelineData

# ── Shopify ───────────────────────────────────────────────────────────────────
# The store this pipeline reads and writes. To move from the dev store to the
# live one, change these two values to the live shop and an Admin API access
# token for it (scopes: read_products, write_products, read_inventory,
# write_inventory, read_locations) — `python preflight.py` verifies all of them
# before anything is written.
#
# If these are unset, config.py falls back to the SBOT_SHOPIFY_* names the
# pipelines/ layer already uses, so both layers target one store by default.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_TOKEN=

# Either a fixed SHOPIFY_TOKEN above, OR a Dev Dashboard app's credentials
# here (the live store uses these). When both are set, these win: the pipeline
# exchanges them for a 24-hour token at startup and renews it on its own. The
# app must be installed on SHOPIFY_SHOP and owned by the same organization.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# On the box use the SBOT_ names instead (SBOT_SHOPIFY_CLIENT_ID and
# SBOT_SHOPIFY_CLIENT_SECRET); both are read.

# The location supplier stock is written to. It must be the store's primary
# location. Every other location is a store: supplier SKUs are set to 0 there.
SHOPIFY_STOCK_LOCATION=Supplier Ordering Stock
SHOPIFY_API_VERSION=2026-01

# Shops treated as safe to write to without the dashboard's extra "this is the
# LIVE store" confirmation. Comma-separated. Anything not listed is treated as
# production.
SBOT_DEV_SHOPS=database-testing-2.myshopify.com
