# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/

# ── Secrets ───────────────────────────────────────────────────────────────────
production/.env

# ── Session / agent working files (not part of the app) ───────────────────────
.claude/
monitoring/

# ── Generated pipeline output ─────────────────────────────────────────────────
# Scraped/cleaned/Shopify CSVs and run logs are regenerated by every pipeline
# run and are not a source of truth. Tracking them added ~150 MB per run to the
# repo. Only the .csv/.log artifacts are ignored — the small .json caches under
# Data/ are deliberately NOT, see below.
pipelines/*/Data/**/*.csv
pipelines/*/Data/**/*.log
pipelines/*/logs/
pipelines/dashboard_logs/
upload_ready/

# Runtime state written by the dashboard on every run (pid/status/timestamps).
pipelines/.dashboard_status.json

# NOTE — intentionally still tracked:
#   pipelines/*/Data/**/*.json
# That covers serp_cache.json, which holds SerpAPI results the client has
# already PAID for. Losing it means re-buying those searches. It stays in
# version control on purpose. Same for the zero_terms_*.json scrape caches
# and the shared sku/handle maps.

# Quarantined no-cost-price rows are regenerated every run (data, not source)
no price detected/*.csv
